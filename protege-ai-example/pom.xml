<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>edu.stanford.protege</groupId>
        <artifactId>protege-parent</artifactId>
        <version>6.0.0-alpha-1</version>
    </parent>
    <artifactId>protege-ai-example</artifactId>
    <packaging>bundle</packaging>
    <dependencies>
        <dependency>
            <groupId>edu.stanford.protege</groupId>
            <artifactId>protege-ai-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>junit</groupId><artifactId>junit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>edu.stanford.protege</groupId><artifactId>protege-ai-core</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource>
                <directory>../protege-editor-owl/src/test/resources</directory>
                <includes><include>ontologies/pizza.owl</include></includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>org.protege.ai.example;singleton:=true</Bundle-SymbolicName>
                        <Export-Package>!**</Export-Package>
                        <Import-Package>*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
