@prefix : <http://example.invalid/declarations/base#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# This imported ontology declares SharedTerm and BaseOnly. The module also declares SharedTerm and
# uses BaseOnly without declaring it.

<http://example.invalid/declarations/base> a owl:Ontology .

:SharedTerm a owl:Class .

:BaseOnly a owl:Class .
