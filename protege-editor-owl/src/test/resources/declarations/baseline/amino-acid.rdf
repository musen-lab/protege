    <!-- http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#A -->

    <owl:Class rdf:about="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#A">
        <rdfs:subClassOf rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#SpecificAminoAcid"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasCharge"/>
                <owl:someValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Neutral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasHydrophobicity"/>
                <owl:someValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Hydrophobic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasPolarity"/>
                <owl:someValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Non-Polar"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
