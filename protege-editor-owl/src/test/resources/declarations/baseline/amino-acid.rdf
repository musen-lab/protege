        <amino-acid:preferredName xml:lang="zh">丙氨酸</amino-acid:preferredName>
        <amino-acid:shortName xml:lang="en">ala</amino-acid:shortName>
        <amino-acid:shortName xml:lang="zh">丙</amino-acid:shortName>
        <amino-acid:singleLetterName xml:lang="en">A</amino-acid:singleLetterName>
        <rdfs:label xml:lang="en">Alanine</rdfs:label>
        <rdfs:label xml:lang="zh">丙氨酸</rdfs:label>
        <rdfs:label xml:lang="zh">氨基丙酸</rdfs:label>
    </owl:Class>
    


    <!-- http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Aliphatic -->

    <owl:Class rdf:about="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Aliphatic">
        <rdfs:subClassOf rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#SideChainStructure"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Aromatic"/>
        <amino-acid:preferredName xml:lang="en">Aliphatic</amino-acid:preferredName>
        <amino-acid:preferredName xml:lang="zh">脂肪族侧链</amino-acid:preferredName>
        <rdfs:label xml:lang="zh">脂肪族型</rdfs:label>
    </owl:Class>
    


    <!-- http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#AliphaticAminoAcid -->

    <owl:Class rdf:about="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#AliphaticAminoAcid">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#AminoAcid"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasSideChainStructure"/>
                        <owl:someValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Aliphatic"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <amino-acid:preferredName xml:lang="en">Aliphatic Amino Acid</amino-acid:preferredName>
        <amino-acid:preferredName xml:lang="zh">脂肪族氨基酸</amino-acid:preferredName>
        <rdfs:label xml:lang="en">Aliphatic Amino Acids</rdfs:label>
    </owl:Class>
    


