        <amino-acid:shortName xml:lang="en">AAs</amino-acid:shortName>
        <rdfs:label xml:lang="en">Amino Acids</rdfs:label>
        <rdfs:label xml:lang="zh">氨酸</rdfs:label>
        <rdfs:label xml:lang="zh">胺</rdfs:label>
        <rdfs:label xml:lang="zh">胺基酸</rdfs:label>
        <rdfs:label xml:lang="zh">胺酸</rdfs:label>
