        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#W"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Y"/>
