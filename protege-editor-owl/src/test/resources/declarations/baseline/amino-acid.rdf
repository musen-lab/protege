    <!-- http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasCharge -->

    <owl:ObjectProperty rdf:about="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasCharge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#AminoAcid"/>
        <rdfs:range rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Charge"/>
        <amino-acid:preferredName xml:lang="en">hasCharge</amino-acid:preferredName>
        <amino-acid:preferredName xml:lang="zh">具有电荷</amino-acid:preferredName>
        <rdfs:label xml:lang="en">has Charge</rdfs:label>
        <rdfs:label xml:lang="en">has_Charge</rdfs:label>
        <rdfs:label xml:lang="zh">带电类型为</rdfs:label>
        <rdfs:label xml:lang="zh">电荷类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasHydrophobicity -->

    <owl:ObjectProperty rdf:about="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasHydrophobicity">
