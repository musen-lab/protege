                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasSize"/>
                <owl:someValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Tiny"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasCharge"/>
                <owl:allValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Neutral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasHydrophobicity"/>
                <owl:allValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Hydrophobic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasPolarity"/>
                <owl:allValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Non-Polar"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasSideChainStructure"/>
                <owl:allValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Aliphatic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#hasSize"/>
                <owl:allValuesFrom rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Tiny"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#C"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#D"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#E"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#F"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#G"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#H"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#I"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#K"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#L"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#M"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#N"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#P"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#Q"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#R"/>
        <owl:disjointWith rdf:resource="http://example.invalid/ontologies/amino-acid/2006/05/18/amino-acid.owl#S"/>
